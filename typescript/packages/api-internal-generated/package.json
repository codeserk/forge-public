{
  "name": "@codeserk/forge-api-internal-generated",
  "version": "0.1.0",
  "description": "Auto-generated TypeScript client for the Forge internal API. Do not edit by hand.",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "generate:local": "openapi-generator-cli generate -i http://localhost:5000/docs/doc.json -g typescript-axios -o src/generated --additional-properties=useSingleRequestParameter=true && curl -sS http://localhost:5000/docs/doc.json -o src/openapi.json",
    "generate:file": "node -e 'const fs=require(\"fs\"),p=process.argv[1];fs.copyFileSync(p,\"src/openapi.json\")' \"$npm_config_swagger\" && openapi-generator-cli generate -g typescript-axios -o src/generated --additional-properties=useSingleRequestParameter=true -i \"$npm_config_swagger\"",
    "publish:dry": "npm publish --dry-run",
    "publish:npm": "npm run build && npm publish"
  },
  "dependencies": {
    "axios": "^1.8.4"
  },
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "^2.18.4",
    "tsdown": "^0.21.4",
    "typescript": "^5.7.0"
  }
}
