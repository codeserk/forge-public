{
  "name": "@codeserk/forge-mcp",
  "version": "0.1.0",
  "description": "MCP server exposing the Forge internal API to AI assistants (Claude Code, Cursor).",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "bin": {
    "forge-mcp": "./dist/cli.mjs"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "start": "node dist/cli.mjs",
    "test": "jest",
    "publish:dry": "npm publish --dry-run",
    "publish:npm": "npm run build && npm publish"
  },
  "dependencies": {
    "@codeserk/forge-api-internal": "*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.11.0",
    "jest": "^30.3.0",
    "ts-jest": "^29.4.6",
    "tsdown": "^0.21.4",
    "typescript": "^5.7.0"
  }
}
